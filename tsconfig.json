{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/core/**/*.ts",
    "src/cli/**/*.ts",
    "src/mcp/**/*.ts",
    "src/server/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/web", "test"]
}
