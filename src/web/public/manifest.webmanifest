{
  "name": "Triathlon",
  "short_name": "Triathlon",
  "description": "Local-first, Markdown-backed work tracker for solo developers and coding agents",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F6F4EF",
  "theme_color": "#F6F4EF",
  "icons": [
