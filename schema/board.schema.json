{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triathlon.dev/schema/board.schema.json",
  "title": "Triathlon board",
  "type": "object",
  "required": ["schemaVersion", "project", "board", "sprints", "tickets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["key", "name", "description", "nextTicketNumber"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "nextTicketNumber": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": ["columns", "pullRequests"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/column" }
        },
        "pullRequests": {
          "type": "object",
          "required": ["openedColumnId", "mergedColumnId"],
          "properties": {
            "openedColumnId": { "type": "string", "minLength": 1 },
            "mergedColumnId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sprints": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sprint" }
    },
    "tickets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/ticket" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableDate": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "column": {
      "type": "object",
      "required": ["id", "name", "category", "wipLimit"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["not-started", "started", "done"] },
        "wipLimit": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "required": ["id", "author", "body", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "ticket": {
      "type": "object",
      "required": ["id", "title", "description", "columnId", "rank", "priority", "storyPoints", "labels", "assignee", "sprintId", "createdAt", "updatedAt", "comments"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "columnId": { "type": "string", "minLength": 1 },
        "rank": { "type": "number" },
        "priority": { "enum": ["low", "medium", "high", "urgent"] },
        "storyPoints": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "labels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "assignee": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "sprintId": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "comments": {
          "type": "array",
          "items": { "$ref": "#/$defs/comment" }
        }
      },
      "additionalProperties": false
    },
    "burndownPoint": {
      "type": "object",
      "required": ["date", "pointsRemaining"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "pointsRemaining": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["calculatedAt", "velocity", "throughput", "averageLeadDays", "averageCycleDays", "burndown"],
      "properties": {
        "calculatedAt": { "type": "string", "format": "date-time" },
        "velocity": { "type": "number", "minimum": 0 },
        "throughput": { "type": "integer", "minimum": 0 },
        "averageLeadDays": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "averageCycleDays": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        },
        "burndown": {
          "type": "array",
          "items": { "$ref": "#/$defs/burndownPoint" }
        }
      },
      "additionalProperties": false
    },
    "sprint": {
      "type": "object",
      "required": ["id", "name", "state", "plannedStart", "plannedEnd", "actualStart", "actualEnd", "ticketIds", "metrics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "state": { "enum": ["planned", "active", "completed"] },
        "plannedStart": { "$ref": "#/$defs/nullableDate" },
        "plannedEnd": { "$ref": "#/$defs/nullableDate" },
        "actualStart": { "$ref": "#/$defs/nullableDate" },
        "actualEnd": { "$ref": "#/$defs/nullableDate" },
        "ticketIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "metrics": {
          "oneOf": [
            { "$ref": "#/$defs/metrics" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
