{
  "name": "agile-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tri": "packages/cli/dist/index.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "vinext lint",
    "typecheck": "tsc --noEmit",
    "cli:build": "npm run build -w @triathlon/client && npm run build -w @triathlon/cli",
    "tri": "npm run -s cli:build && node packages/cli/dist/index.js",
    "server:dev": "npm run dev -w @triathlon/server",
    "server:test": "npm run test -w @triathlon/server",
    "generated": "npm run openapi -w @triathlon/server && npm run generate -w @triathlon/client",
    "generated:check": "npm run generated && git diff --exit-code -- apps/server/openapi.json packages/client/src/schema.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.46.0",
    "better-auth": "1.4.9",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "vinext": "^0.0.21"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "openapi-typescript": "^7.9.1",
    "oxlint": "1.81.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
