# Triathlon server configuration. Every setting can be overridden with
# TRI_<SETTING> environment variables; `triathlon config` prints the
# resolved configuration with secrets redacted.

host: 0.0.0.0
port: 8080
# baseUrl: https://triathlon.example.com

# SQLite database file (WAL mode; backups are plain file copies).
databasePath: ./data/triathlon.db

logLevel: info
# Instance default timezone; projects inherit it.
timezone: UTC

# Origins allowed to send credentialed (cookie) browser requests.
trustedOrigins:
  - http://localhost:3000

auth:
  # Generate with: openssl rand -base64 32
  secret: replace-with-a-random-32-byte-secret

session:
  cookieName: tri_session
  ttlDays: 30
  secure: false

bootstrap:
  # Lifetime of the one-time owner bootstrap code.
  codeTtlMinutes: 30

invitations:
  # Default lifetime of project invitations.
  defaultTtlDays: 7

instanceWideKeys:
  # Instance-wide keys may not live longer than this.
  maxTtlDays: 90

maintenance:
  intervalMinutes: 60

backups:
  directory: ./backups
  enabled: true
  dailyRetention: 7
  weeklyRetention: 4

docs:
  enabled: true
